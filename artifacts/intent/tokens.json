  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "sans-serif"
        ],
        "$description": "Display and body voice. Headlines run semibold with tight (-0.04em to -0.07em) tracking."
      },
      "serif": {
        "$value": [
          "Georgia",
          "serif"
        ]
      },
      "mono": {
        "$value": [
          "IBM Plex Mono",
          "ui-monospace",
          "monospace"
        ],
        "$description": "The system's workhorse: micro-labels (uppercase, 0.13-0.22em tracking), dates, codes, and every numeral (tabular)."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme (8/10/12/16px). Pills are fully rounded."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  },
  "motion": {
    "$description": "Motion easing tokens (emil-design-eng): built-in CSS keywords are too weak to feel intentional. ease-out-strong for entrances/press feedback, ease-in-out-strong for moves/morphs, ease-drawer for sheets and drawers. Never use `transition-all`; gate hover styles behind (hover:hover) and (pointer:fine).",
    "easeOutStrong": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.23, 1, 0.32, 1)"
    },
    "easeInOutStrong": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.77, 0, 0.175, 1)"
    },
    "easeDrawer": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.32, 0.72, 0, 1)"
    }
  }
}
